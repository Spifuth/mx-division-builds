# API image. Dependencies are baked in rather than mounted, so the container
# starts deterministically and the host never needs Python.
FROM python:3.12-slim

WORKDIR /srv

# Non-root, matching the host uid so bind-mounted files stay writable -- same
# reasoning as Dockerfile.dev.
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} api && useradd -u ${UID} -g ${GID} -m -s /bin/sh api

COPY api/requirements.txt api/requirements-dev.txt /srv/
RUN pip install --no-cache-dir -r requirements-dev.txt

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Create the mount points in the image, owned by the runtime user. Docker seeds
# an EMPTY named volume from the image path -- content and ownership both -- so
# without this the volumes come up root-owned and the non-root process cannot
# write a snapshot or a database. The failure is late and confusing: the service
# boots fine, serves fine, and only fails when a refresh first tries to write.
RUN mkdir -p /srv/snapshots /srv/db && chown -R api:api /srv/snapshots /srv/db

USER api
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
