# Dev-only image. Deps are installed into a named volume at first run,
# so the host never needs Node installed and a bind-mounted source tree
# cannot shadow node_modules.
FROM node:22-alpine

WORKDIR /app

# Silence "npm notice New major version of npm available!" -- this is a
# dev-only image rebuilt through ./scripts/dev.sh build, not a place we
# want npm nagging to self-update; it was polluting pasted command output
# in every task report. Build-time image setting, not app config.
ENV NPM_CONFIG_UPDATE_NOTIFIER=false

# git: nothing in this repo shells out to git. Checked -- src/, scripts/, the
# config files and package.json contain no child_process/execSync/spawn/
# simple-git, the lockfile resolves zero git+ dependencies, and
# VersionModal.vue is a static changelog with no git in it at all. The
# previous comment here ("the version modal and some tooling shell out to it")
# was simply wrong.
#
# Kept, not removed, because it is the working git for anyone who
# `docker exec`s into the container against the bind-mounted repo -- but be
# clear that nothing in the build, the tests or the app needs it, so it can go
# if that is not wanted.
RUN apk add --no-cache git

# Non-root, matching the host uid so bind-mounted files stay writable.
ARG UID=1000
ARG GID=1000
RUN deluser --remove-home node \
 && addgroup -g ${GID} app \
 && adduser -u ${UID} -G app -s /bin/sh -D app

RUN mkdir -p /app/node_modules && chown -R app:app /app

USER app
EXPOSE 8090
CMD ["npm", "run", "dev"]
