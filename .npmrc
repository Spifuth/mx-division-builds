# webpack 4 (vue-cli 4) hashes assets with md4, which OpenSSL 3 removed in Node 17+.
# Several plugins (html-webpack-plugin's child compiler, chunk hashing) hardcode it,
# so setting output.hashFunction in vue.config.js is necessary but not sufficient.
# Set here rather than inline in the "serve" script so it works on any shell/OS.
node-options=--openssl-legacy-provider
